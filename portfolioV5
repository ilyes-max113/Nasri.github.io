<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Portfolio professionnel d'Ilyes Nasr Chatti - Alternant Technicien Systèmes et Réseaux en 1ère année de BTS SIO SISR chez Transports Suma.">
    <title>SI-MONITOR // Ilyes Nasr Chatti - Portfolio SISR</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* --- SYSTEM DESIGN & VARIABLES --- */
        :root {
            --bg-grid-color: rgba(14, 165, 233, 0.04);
            --bg-grid-color-major: rgba(14, 165, 233, 0.08);
            --bg-main: #f8fafc;
            --bg-card: #ffffff;
            --bg-dark-console: #f1f5f9;
            
            --border-tech: rgba(14, 165, 233, 0.25);
            --border-tech-active: #0ea5e9;
            --border-faint: #e2e8f0;
            
            --primary: #0ea5e9; /* Cyan */
            --primary-hover: #0284c7;
            --secondary: #1e3a8a; /* Cobalt/Marine */
            --secondary-light: #3b82f6;
            
            --text-main: #334155;
            --text-muted: #64748b;
            --text-navy: #1e3a8a;
            --text-cyan: #0284c7;
            
            --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
            --font-mono: 'Fira Code', Consolas, monospace;
            
            --shadow-sm: 0 1px 3px rgba(30, 58, 138, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(30, 58, 138, 0.05), 0 2px 4px -1px rgba(30, 58, 138, 0.03);
            --shadow-lg: 0 10px 25px -5px rgba(30, 58, 138, 0.08), 0 8px 10px -6px rgba(30, 58, 138, 0.08);
            
            --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* --- RESET & BASIC STYLES --- */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--bg-main);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            position: relative;
            
            /* Blueprint Grid Pattern */
            background-image: 
                linear-gradient(var(--bg-grid-color) 1px, transparent 1px),
                linear-gradient(90deg, var(--bg-grid-color) 1px, transparent 1px),
                linear-gradient(var(--bg-grid-color-major) 1px, transparent 1px),
                linear-gradient(90deg, var(--bg-grid-color-major) 1px, transparent 1px);
            background-size: 20px 20px, 20px 20px, 100px 100px, 100px 100px;
            background-position: center center;
        }

        /* Subtle Blueprint Decorative Elements */
        body::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 100%;
            background: radial-gradient(circle at 50% 30%, rgba(14, 165, 233, 0.03) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        /* --- HEADER / TOP BAR --- */
        .top-bar {
            background-color: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--border-tech);
            padding: 0.75rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow-sm);
        }

        .system-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-family: var(--font-mono);
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--secondary);
            letter-spacing: -0.025em;
        }

        .system-title span {
            color: var(--primary);
        }

        .sys-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background-color: rgba(14, 165, 233, 0.08);
            border: 1px solid rgba(14, 165, 233, 0.2);
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-cyan);
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: var(--primary);
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 0 0 rgba(14, 165, 233, 0.7);
            animation: pulse 1.8s infinite;
        }

        @keyframes pulse {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(14, 165, 233, 0.7);
            }
            70% {
                transform: scale(1);
                box-shadow: 0 0 0 6px rgba(14, 165, 233, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(14, 165, 233, 0);
            }
        }

        .sys-metrics {
            display: flex;
            gap: 1.5rem;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .metric-item strong {
            color: var(--secondary);
        }

        /* --- MAIN LAYOUT CONTAINER --- */
        .dashboard-container {
            max-width: 1440px;
            width: 100%;
            margin: 1.5rem auto;
            padding: 0 1.5rem;
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 1.5rem;
            flex-grow: 1;
            z-index: 10;
        }

        /* --- LEFT SIDEBAR (MONITOR PROFILE) --- */
        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .profile-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-tech);
            border-radius: 12px;
            padding: 1.75rem;
            box-shadow: var(--shadow-md);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .profile-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background-color: var(--primary);
        }

        .profile-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            border-bottom: 1px solid var(--border-faint);
            padding-bottom: 1.25rem;
        }

        /* Custom schematic avatar */
        .avatar-container {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.1) 0%, rgba(30, 58, 138, 0.1) 100%);
            border: 2px dashed var(--primary);
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 1rem;
            position: relative;
        }

        .avatar-container svg {
            width: 40px;
            height: 40px;
            color: var(--secondary);
        }

        .avatar-badge {
            position: absolute;
            bottom: 2px;
            right: 2px;
            background-color: #ffffff;
            border: 1px solid var(--border-tech);
            border-radius: 50%;
            padding: 2px;
            display: flex;
        }

        .profile-name {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--secondary);
            line-height: 1.2;
            letter-spacing: -0.02em;
        }

        .profile-title {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-cyan);
            margin-top: 0.25rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .profile-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            justify-content: center;
            margin-top: 0.75rem;
        }

        .tag {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            background-color: var(--bg-main);
            color: var(--secondary);
            border: 1px solid var(--border-faint);
            border-radius: 4px;
            transition: var(--transition-smooth);
        }

        .tag:hover {
            border-color: var(--primary);
            color: var(--primary);
            background-color: rgba(14, 165, 233, 0.05);
        }

        /* Metadata Table */
        .info-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.8rem;
        }

        .info-table tr {
            border-bottom: 1px solid var(--border-faint);
        }

        .info-table tr:last-child {
            border-bottom: none;
        }

        .info-table td {
            padding: 0.65rem 0;
            vertical-align: middle;
        }

        .info-table td.label {
            font-family: var(--font-mono);
            color: var(--text-muted);
            font-weight: 600;
            width: 40%;
        }

        .info-table td.value {
            color: var(--secondary);
            font-weight: 700;
            text-align: right;
        }

        /* Action Buttons */
        .action-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            background-color: var(--secondary);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            padding: 0.75rem;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition-smooth);
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            box-shadow: 0 4px 10px rgba(30, 58, 138, 0.15);
        }

        .action-button:hover {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(14, 165, 233, 0.25);
        }

        .action-button svg {
            width: 16px;
            height: 16px;
        }

        /* Small telemetry monitor block */
        .telemetry-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-tech);
            border-radius: 12px;
            padding: 1.25rem;
            box-shadow: var(--shadow-md);
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .telemetry-title {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .telemetry-value {
            font-family: var(--font-mono);
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--secondary);
            display: flex;
            align-items: baseline;
            gap: 0.25rem;
        }

        .telemetry-value span {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 400;
        }

        /* --- RIGHT CONTENT AREA (MODULES GRID) --- */
        .main-content {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .grid-header {
            background-color: var(--bg-card);
            border: 1px solid var(--border-tech);
            border-radius: 12px;
            padding: 1.25rem 1.75rem;
            box-shadow: var(--shadow-md);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .grid-header-title h2 {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--secondary);
            letter-spacing: -0.02em;
        }

        .grid-header-title p {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 0.15rem;
        }

        .sys-counters {
            display: flex;
            gap: 2rem;
        }

        .counter-box {
            text-align: right;
        }

        .counter-label {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .counter-num {
            font-family: var(--font-mono);
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--secondary);
        }

        /* --- THE 4 INTERACTIVE CARDS --- */
        .modules-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }

        .module-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-tech);
            border-radius: 12px;
            padding: 1.75rem;
            box-shadow: var(--shadow-md);
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 250px;
            position: relative;
            overflow: hidden;
        }

        .module-card::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 40px;
            height: 40px;
            background: linear-gradient(45deg, transparent 45%, rgba(14, 165, 233, 0.1) 46%, var(--primary) 100%);
            transition: var(--transition-smooth);
        }

        .module-card:hover {
            transform: translateY(-4px);
            border-color: var(--primary);
            box-shadow: 0 12px 20px -8px rgba(14, 165, 233, 0.25), var(--shadow-lg);
        }

        .module-card:hover::after {
            transform: scale(1.2);
        }

        .module-card.active {
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.3), var(--shadow-lg);
        }

        .card-top {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .module-id {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .module-id span {
            width: 6px;
            height: 6px;
            background-color: var(--primary);
            border-radius: 50%;
        }

        .module-title {
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--secondary);
            letter-spacing: -0.02em;
        }

        .module-preview {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 0.5rem;
            line-height: 1.5;
        }

        /* Minimal list/tag design on preview */
        .preview-list {
            margin-top: 1rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        .preview-bullet {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.25rem 0.5rem;
            background-color: var(--bg-main);
            color: var(--secondary);
            border-radius: 4px;
            border: 1px solid var(--border-faint);
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .preview-bullet svg {
            width: 12px;
            height: 12px;
            color: var(--primary);
        }

        .card-footer {
            margin-top: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--border-faint);
            padding-top: 1rem;
        }

        .click-action {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: flex;
            align-items: center;
            gap: 0.35rem;
            transition: var(--transition-smooth);
        }

        .module-card:hover .click-action {
            color: var(--secondary);
            gap: 0.6rem;
        }

        .click-action svg {
            width: 12px;
            height: 12px;
        }

        /* --- SLIDE-OUT DETAIL PANEL (DRAWER) --- */
        .detail-drawer {
            position: fixed;
            top: 0;
            right: -520px; /* Hidden initially */
            width: 500px;
            height: 100vh;
            background-color: #ffffff;
            border-left: 1px solid var(--border-tech);
            box-shadow: -10px 0 30px rgba(30, 58, 138, 0.15);
            z-index: 1000;
            transition: right 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
        }

        .detail-drawer.open {
            right: 0;
        }

        .drawer-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(30, 58, 138, 0.15);
            backdrop-filter: blur(4px);
            z-index: 999;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition-smooth);
        }

        .drawer-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }

        .drawer-header {
            padding: 1.5rem 2rem;
            border-bottom: 1px solid var(--border-faint);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: var(--bg-main);
        }

        .drawer-meta {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--primary);
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .drawer-title {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--secondary);
            margin-top: 0.25rem;
        }

        .close-btn {
            background: none;
            border: 1px solid var(--border-faint);
            border-radius: 6px;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--text-muted);
            transition: var(--transition-smooth);
        }

        .close-btn:hover {
            background-color: rgba(226, 232, 240, 0.5);
            color: var(--secondary);
            border-color: var(--primary);
        }

        .close-btn svg {
            width: 18px;
            height: 18px;
        }

        .drawer-content {
            padding: 2rem;
            overflow-y: auto;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 1.75rem;
        }

        /* Detail Typography & Elements */
        .drawer-section {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .section-label {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--text-cyan);
            text-transform: uppercase;
            letter-spacing: 0.05rem;
            border-bottom: 1px solid rgba(14, 165, 233, 0.15);
            padding-bottom: 0.25rem;
        }

        .text-desc {
            font-size: 0.85rem;
            line-height: 1.6;
            color: var(--text-main);
        }

        .bullet-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
        }

        .bullet-list li {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--secondary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .bullet-list li svg {
            width: 16px;
            height: 16px;
            color: var(--primary);
            flex-shrink: 0;
        }

        /* Timeline style (Module 01) */
        .timeline {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 0.5rem;
        }

        .timeline-item {
            display: flex;
            gap: 1rem;
            position: relative;
        }

        .timeline-item::before {
            content: "";
            position: absolute;
            left: 55px;
            top: 20px;
            bottom: -20px;
            width: 2px;
            background-color: var(--border-faint);
        }

        .timeline-item:last-child::before {
            display: none;
        }

        .time-badge {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--primary);
            background-color: rgba(14, 165, 233, 0.08);
            border: 1px solid rgba(14, 165, 233, 0.15);
            padding: 0.15rem 0.4rem;
            border-radius: 4px;
            height: fit-content;
            width: 55px;
            text-align: center;
        }

        .time-dot {
            width: 10px;
            height: 10px;
            background-color: #ffffff;
            border: 2.5px solid var(--primary);
            border-radius: 50%;
            margin-top: 4px;
            z-index: 2;
        }

        .time-content {
            flex-grow: 1;
        }

        .time-task {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--secondary);
        }

        .time-subtext {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 0.1rem;
        }

        /* Mini Sub-sections (Module 02) */
        .sub-project {
            background-color: var(--bg-main);
            border: 1px solid var(--border-faint);
            border-radius: 8px;
            padding: 1.25rem;
            margin-bottom: 0.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .sub-project h4 {
            font-size: 0.9rem;
            font-weight: 800;
            color: var(--secondary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .sub-project h4 svg {
            width: 16px;
            height: 16px;
            color: var(--primary);
        }

        /* Terminal Simulator (Module 03) */
        .terminal-container {
            background-color: var(--bg-dark-console);
            border: 1px solid var(--border-faint);
            border-radius: 8px;
            padding: 1rem;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            line-height: 1.4;
            color: var(--secondary);
            height: 180px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02);
        }

        .terminal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(30, 58, 138, 0.05);
            padding-bottom: 0.5rem;
            margin-bottom: 0.5rem;
            color: var(--text-muted);
        }

        .terminal-controls {
            display: flex;
            gap: 4px;
        }

        .terminal-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: rgba(30, 58, 138, 0.15);
        }

        .terminal-dot.red { background-color: rgba(239, 68, 68, 0.3); }
        .terminal-dot.yellow { background-color: rgba(245, 158, 11, 0.3); }
        .terminal-dot.green { background-color: rgba(34, 197, 94, 0.3); }

        .terminal-body {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .cli-prompt {
            color: var(--primary);
            font-weight: 700;
        }

        .cli-success {
            color: #10b981;
            font-weight: 600;
        }

        .cli-info {
            color: var(--text-muted);
        }

        /* Form styling (Module 04 / Contact modal) */
        .contact-form {
            display: flex;
