                "default via 10.0.10.1 dev eth0 proto static metric 100",
                "10.0.10.0/24 dev eth0 proto kernel scope link src 10.0.10.15"
            ]}
        ];

        function startTerminalSimulation() {
            const container = document.getElementById('terminal-body');
            container.innerHTML = ""; // Clear
            
            let commandIndex = 0;
            let lineIndex = 0;
            let currentCmdObj = null;
            let typingCmd = false;

            function runCycle() {
                if (!currentCmdObj) {
                    currentCmdObj = terminalCommands[commandIndex];
                    // Append prompt & start typing the command
                    const promptLine = document.createElement('div');
                    promptLine.innerHTML = `<span class='cli-prompt'>ilyes@si-node:~$</span> <span class='cmd-text'></span>`;
                    container.appendChild(promptLine);
                    container.scrollTop = container.scrollHeight;
                    
                    let charIndex = 0;
                    const cmdTextSpan = promptLine.querySelector('.cmd-text');
                    
                    typingCmd = true;
                    const typingInterval = setInterval(() => {
                        if (charIndex < currentCmdObj.cmd.length) {
                            cmdTextSpan.textContent += currentCmdObj.cmd.charAt(charIndex);
                            charIndex++;
                            container.scrollTop = container.scrollHeight;
                        } else {
                            clearInterval(typingInterval);
                            typingCmd = false;
                            lineIndex = 0;
                            // Wait a short delay, then output lines
                            setTimeout(printOutputs, 250);
                        }
                    }, 40);
                }
            }

            function printOutputs() {
                if (lineIndex < currentCmdObj.output.length) {
                    const outputLine = document.createElement('div');
                    outputLine.innerHTML = currentCmdObj.output[lineIndex];
                    container.appendChild(outputLine);
                    container.scrollTop = container.scrollHeight;
                    lineIndex++;
                    setTimeout(printOutputs, 150);
                } else {
                    // Command output finished, wait before next command
                    currentCmdObj = null;
                    commandIndex = (commandIndex + 1) % terminalCommands.length;
                    setTimeout(runCycle, 1500);
                }
            }

            runCycle();
        }
