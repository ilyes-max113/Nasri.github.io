    <!-- Web Audio & Particles & Terminal Animations JavaScript -->
    <script>
        // --- 1. WEB AUDIO API SYNTHESIZER ---
        let audioCtx = null;
        let isAudioEnabled = false;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function toggleAudio() {
            isAudioEnabled = !isAudioEnabled;
            const audioText = document.getElementById('audio-text');
            const toggleBox = document.getElementById('audio-toggle');
            const svgPath = document.getElementById('audio-svg-path');
            const svgMutedPath = document.getElementById('audio-svg-muted-path');
            
            initAudio();

            if (isAudioEnabled) {
                audioText.innerText = "AUDIO: ON";
                audioText.style.color = "var(--neon-blue)";
                toggleBox.style.borderColor = "var(--neon-blue)";
                svgPath.style.display = "block";
                svgMutedPath.style.display = "none";
                
                // Play startup chime
                playBeep(440, 'sine', 0.1, 0.05);
                setTimeout(() => playBeep(554, 'sine', 0.1, 0.05), 100);
                setTimeout(() => playBeep(659, 'sine', 0.2, 0.05), 200);
                setTimeout(() => playBeep(880, 'sine', 0.3, 0.08), 300);
            } else {
                audioText.innerText = "AUDIO: OFF";
                audioText.style.color = "var(--text-muted)";
                toggleBox.style.borderColor = "var(--border-color)";
                svgPath.style.display = "none";
                svgMutedPath.style.display = "block";
            }
        }

        function playBeep(freq, type, duration, volume) {
            if (!isAudioEnabled) return;
            initAudio();
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                
                osc.type = type || 'sine';
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                
                gain.gain.setValueAtTime(volume || 0.05, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
                
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch (e) {
                console.error("Audio error", e);
            }
        }

        function playClickSound() {
            playBeep(800, 'sine', 0.08, 0.03);
            setTimeout(() => playBeep(1200, 'sine', 0.05, 0.03), 25);
        }

        function playHoverSound() {
            playBeep(700, 'sine', 0.04, 0.01);
        }

        function playCloseSound() {
            playBeep(450, 'sawtooth', 0.15, 0.01);
        }


        // --- 2. OPTIMIZED CANVAS NETWORK NODES ---
        const canvas = document.getElementById('network-canvas');
        const ctx = canvas.getContext('2d');
        const fpsDisplay = document.getElementById('fps-display');
        
        let nodes = [];
        let numNodes = 40; // Max 40-50 nodes on desktop
        const connectionDistance = 120;
        let isTabActive = true;
        let lastTime = performance.now();
        let frameCount = 0;
        let mouse = { x: null, y: null };

        // Adjust node count on mobile
        function initCanvasSize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            if (canvas.width < 768) {
                numNodes = 18; // Limit further for low end mobile CPU
            } else {
                numNodes = 40;
            }
            createNodes();
        }

        class Node {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.vx = (Math.random() - 0.5) * 0.4;
                this.vy = (Math.random() - 0.5) * 0.4;
                this.r = Math.random() * 2 + 1;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;

                // Bounce off edges
                if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
                if (this.y < 0 || this.y > canvas.height) this.vy *= -1;

                // Mouse interaction
                if (mouse.x !== null && mouse.y !== null) {
                    const dx = mouse.x - this.x;
                    const dy = mouse.y - this.y;
                    const dist = Math.hypot(dx, dy);
                    if (dist < 150) {
                        // Gently attract to mouse
                        this.x += dx * 0.005;
                        this.y += dy * 0.005;
                    }
                }
            }

            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(0, 240, 255, 0.4)';
                ctx.fill();
            }
        }

        function createNodes() {
            nodes = [];
            for (let i = 0; i < numNodes; i++) {
                nodes.push(new Node());
            }
        }

        function drawConnections() {
            for (let i = 0; i < nodes.length; i++) {
                for (let j = i + 1; j < nodes.length; j++) {
                    const dx = nodes[i].x - nodes[j].x;
                    const dy = nodes[i].y - nodes[j].y;
                    const dist = Math.hypot(dx, dy);
                    
                    if (dist < connectionDistance) {
                        const alpha = (1 - dist / connectionDistance) * 0.15;
                        ctx.beginPath();
                        ctx.moveTo(nodes[i].x, nodes[i].y);
                        ctx.lineTo(nodes[j].x, nodes[j].y);
                        ctx.strokeStyle = `rgba(0, 240, 255, ${alpha})`;
                        ctx.lineWidth = 1;
                        ctx.stroke();
                    }
                }
            }
        }

        function animate(timestamp) {
            // Stop computing and drawing completely if tab is out of focus
            if (!isTabActive) return;

            // Calculate FPS
            frameCount++;
            if (timestamp > lastTime + 1000) {
                const fps = Math.round((frameCount * 1000) / (timestamp - lastTime));
                fpsDisplay.textContent = fps;
                frameCount = 0;
                lastTime = timestamp;
            }

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Draw grid accent under nodes
            nodes.forEach(node => {
                node.update();
                node.draw();
            });

            drawConnections();

            requestAnimationFrame(animate);
        }

        // Track focus to optimize CPU usage
        document.addEventListener('visibilitychange', () => {
            isTabActive = !document.hidden;
            if (isTabActive) {
                lastTime = performance.now();
                frameCount = 0;
                animate(performance.now());
            }
        });

        // Mouse move tracking
        window.addEventListener('mousemove', (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
        });

        window.addEventListener('mouseout', () => {
            mouse.x = null;
            mouse.y = null;
        });

        // Touch support for mobiles
        window.addEventListener('touchmove', (e) => {
            if(e.touches.length > 0) {
                mouse.x = e.touches[0].clientX;
                mouse.y = e.touches[0].clientY;
            }
        });
        
        window.addEventListener('touchend', () => {
            mouse.x = null;
            mouse.y = null;
        });

        window.addEventListener('resize', initCanvasSize);

        // Start Canvas
        initCanvasSize();
        requestAnimationFrame(animate);


        // --- 3. TERMINAL LOGS SIMULATOR ---
        const terminalBody = document.getElementById('terminal-body');
        
        const terminalLogs = [
            { cmd: "ping -c 4 ad-dc1.villeton.fr", output: "PING ad-dc1.villeton.fr (192.168.10.11) 56(84) bytes of data.\n64 bytes from 192.168.10.11: icmp_seq=1 ttl=64 time=0.87 ms\n64 bytes from 192.168.10.11: icmp_seq=2 ttl=64 time=0.92 ms\n64 bytes from 192.168.10.11: icmp_seq=3 ttl=64 time=0.74 ms\n64 bytes from 192.168.10.11: icmp_seq=4 ttl=64 time=0.98 ms\n\n--- ad-dc1.villeton.fr ping statistics ---\n4 packets transmitted, 4 received, 0% packet loss, time 3004ms\nrtt min/avg/max/mdev = 0.740/0.877/0.980/0.088 ms\n[STATUS: CONNECTIVITY SUCCESSFUL]" },
            
            { cmd: "proxmox-ve status --nodes", output: "[INFO] Initializing Proxmox Cluster Check...\n[NODE] pve-master1 (192.168.10.10) - STATUS: ONLINE\n[VM 101] Samba-AD-DC (192.168.10.11) - STATUS: RUNNING\n[CT 201] Adguard-DNS (192.168.10.100) - STATUS: RUNNING\n[CT 202] GLPI-Asset-Mgr (192.168.10.120) - STATUS: RUNNING\n[CT 203] Samba-Share (192.168.10.12) - STATUS: RUNNING\n[INFO] Resources Allocation: CPU 12.4%, RAM 16.5GB/32GB - SYSTEM HEALTHY" },
            
            { cmd: "samba-tool domain info 192.168.10.11", output: "Forest           : villeton.fr\nDomain           : villeton.fr\nNetbios domain   : VILLETON\nDC name          : ad-dc1.villeton.fr\nLDAP Port        : 389\nLDAPS Port       : 636\nKerberos Realm   : VILLETON.FR\nSTATUS           : AD DC RUNNING - REPLICATION STABLE" },
            
            { cmd: "check-gws-domain --domain villeton.fr", output: "[GWS-API] Authenticating admin account...\n[GWS-API] Connecting to Google Workspace console for domain @villeton.fr\n[SUCCESS] Sync AD groups with Google Workspace done.\n[INFO] Active Google Accounts: 142 Users configured.\n[INFO] Intranet Site Status: https://sites.google.com/a/villeton.fr/intranet [ONLINE]" },
            
            { cmd: "cctv-matrix-check --site multi", output: "[CCTV] Querying site controllers...\n[SITE] Rognac Siège (DVR Gateway: 192.168.100.5) - 12/12 CAMERAS ACTIVE\n[SITE] Vitrolles Dépôt (DVR Gateway: 192.168.101.5) - 8/8 CAMERAS ACTIVE\n[SITE] Marseille Site (DVR Gateway: 192.168.102.5) - 6/6 CAMERAS ACTIVE\n[SECURITY] Local manager sub-accounts rights applied.\n[SECURITY] External public IP filtering applied: ACCESS RESTRICTED TO VPN IPS." },
            
            { cmd: "adguard-cli status --stats", output: "[DNS-FILTER] Server status: ACTIVE on 192.168.10.100\n[DNS-FILTER] Blocked queries last 24h: 42,192 (18.4% of total queries)\n[DNS-FILTER] Running Upstreams: Cloudflare Security DNS Over HTTPS (DoH)\n[DNS-FILTER] Local domain resolution: active for *.villeton.fr" },
            
            { cmd: "glpi-cli sync --network 192.168.10.0/24", output: "[GLPI] Initializing automatic fusioninventory discovery...\n[GLPI] Found 48 network devices, 8 servers, 12 printer gateways.\n[GLPI] Sync status: 0 differences found with database.\n[GLPI] Active Tickets: 3 Open (All Level 1 Support) - Assigned." }
        ];

        let logIndex = 0;

        function printToTerminal() {
            if (terminalLogs.length === 0) return;
            
            const current = terminalLogs[logIndex];
            
            // 1. Write Command Prompt Line
            const cmdLine = document.createElement('div');
            cmdLine.className = 'term-input';
            cmdLine.innerHTML = `ilyes@sisr-portal:~$ `;
            terminalBody.appendChild(cmdLine);
            
            // Simulate typing of command
            let charIndex = 0;
            const commandStr = current.cmd;
            
            function typeChar() {
                if (charIndex < commandStr.length) {
                    cmdLine.innerHTML += commandStr.charAt(charIndex);
                    charIndex++;
                    playBeep(900, 'sine', 0.02, 0.005);
                    setTimeout(typeChar, 40 + Math.random() * 40);
                } else {
                    // Command finished typing, print output after small delay
                    setTimeout(() => {
                        const outputLine = document.createElement('pre');
                        outputLine.className = 'term-output';
                        
                        // Colorize specific output keys
                        let coloredText = current.output
                            .replace(/ONLINE|RUNNING|ACTIVE|SUCCESSFUL|STABLE|HEALTHY/g, '<span class="term-success">$&</span>')
                            .replace(/WARNING/g, '<span class="term-warning">$&</span>')
                            .replace(/BLOQUÉ|RESTRICTED|ERROR|FAILED/g, '<span class="term-error">$&</span>');
                            
                        outputLine.innerHTML = coloredText;
                        terminalBody.appendChild(outputLine);
                        
                        // Play print beep
                        playBeep(600, 'sine', 0.08, 0.01);
                        
                        // Scroll to bottom
                        terminalBody.scrollTop = terminalBody.scrollHeight;
                        
                        // Move to next log after delay
                        logIndex = (logIndex + 1) % terminalLogs.length;
                        setTimeout(printToTerminal, 4000);
                        
                    }, 500);
                }
            }
            
            typeChar();
        }

        // Start terminal sequence
        setTimeout(printToTerminal, 1500);


        // --- 4. INTERACTIVE EXPANSION MODULES (MODALS) ---
        function openModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.add('active');
                
                // Track modal content layout and animate progress bars if skill modal is opened
                if (modalId === 'modal-competences') {
                    setTimeout(() => {
                        const progressBars = modal.querySelectorAll('.skill-bar-inner');
                        progressBars.forEach(bar => {
                            const targetWidth = bar.getAttribute('data-target-width');
                            bar.style.width = targetWidth;
                        });
                    }, 300);
                }
            }
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.remove('active');
                
                // Reset progress bars width on close to re-animate on next open
                if (modalId === 'modal-competences') {
                    const progressBars = modal.querySelectorAll('.skill-bar-inner');
                    progressBars.forEach(bar => {
                        bar.style.width = '0';
                    });
                }
            }
        }

        // Close modal on background click
        window.addEventListener('click', (e) => {
            if (e.target.classList.contains('overlay-screen')) {
                const openModalId = e.target.id;
                closeModal(openModalId);
                playCloseSound();
            }
        });


        // --- 5. CONTACT FORM & NOTIFICATION ---
        function handleContactSubmit(event) {
            event.preventDefault();
            
            const name = document.getElementById('user-name').value;
            const email = document.getElementById('user-email').value;
            const msg = document.getElementById('user-msg').value;

            if (name && email && msg) {
                // Play notification alert sound
                playBeep(880, 'sine', 0.1, 0.05);
                setTimeout(() => playBeep(1200, 'sine', 0.1, 0.05), 80);
                setTimeout(() => playBeep(1500, 'sine', 0.3, 0.08), 160);

                // Show custom HUD alert
                const alertBox = document.getElementById('hud-alert-box');
                alertBox.classList.add('active');
                
                // Clear form
                event.target.reset();

                // Auto hide alert after 4 seconds
                setTimeout(() => {
                    alertBox.classList.remove('active');
                }, 4000);
            }
        }
    </script>
</body>
