<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Portfolio professionnel d'Ilyes Nasr Chatti - Technicien Systèmes et Réseaux en Alternance (BTS SIO SISR)">
    <title>ILYÈS NASR CHATTI // SISR PORTAL</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Rajdhani:wght@500;600;700&family=Fira+Code:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- CSS Styles -->
    <style>
        :root {
            --bg-deep: #020208;
            --bg-grid: #050512;
            --neon-blue: #00f0ff;
            --neon-violet: #bd00ff;
            --neon-blue-glow: rgba(0, 240, 255, 0.4);
            --neon-violet-glow: rgba(189, 0, 255, 0.4);
            --panel-bg: rgba(6, 6, 20, 0.75);
            --border-color: rgba(0, 240, 255, 0.15);
            --border-hover: rgba(0, 240, 255, 0.5);
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --terminal-bg: rgba(2, 2, 6, 0.9);
            --font-hud: 'Orbitron', sans-serif;
            --font-body: 'Rajdhani', sans-serif;
            --font-mono: 'Fira Code', monospace;
        }

        /* Reset & Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }

        body {
            background-color: var(--bg-deep);
            color: var(--text-main);
            font-family: var(--font-body);
            font-size: 1.1rem;
            overflow-x: hidden;
            height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* Scanlines Overlay Effect */
        body::after {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                rgba(18, 18, 30, 0) 0%,
                rgba(18, 18, 30, 0) 50%,
                rgba(0, 240, 255, 0.02) 50%,
                rgba(0, 240, 255, 0.02) 100%
            );
            background-size: 100% 4px;
            z-index: 9999;
            pointer-events: none;
            opacity: 0.65;
        }

        /* Grid Background Pattern */
        .cyber-grid {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: 
                linear-gradient(rgba(0, 240, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -2;
            pointer-events: none;
        }

        /* Animated Radial Vignette for Depth */
        .vignette {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, transparent 30%, rgba(2, 2, 8, 0.9) 100%);
            z-index: -1;
            pointer-events: none;
        }

        /* Canvas for Network Node Animation */
        #network-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: all;
        }

        /* Scrollbar styles */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-deep);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--neon-blue);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--neon-violet);
        }

        /* --- UI COMPONENTS --- */

        /* System Header */
        header {
            width: 100%;
            padding: 15px 30px;
            background: rgba(4, 4, 12, 0.85);
            border-bottom: 2px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            backdrop-filter: blur(10px);
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.5);
        }

        .header-title-box {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: var(--neon-blue);
            box-shadow: 0 0 10px var(--neon-blue);
            animation: pulse-dot 2s infinite alternate;
        }

        @keyframes pulse-dot {
            0% { opacity: 0.4; }
            100% { opacity: 1; box-shadow: 0 0 15px var(--neon-blue); }
        }

        .header-logo {
            font-family: var(--font-hud);
            font-weight: 900;
            font-size: 1.4rem;
            letter-spacing: 2px;
            color: #fff;
            text-shadow: 0 0 10px rgba(255,255,255,0.3), 0 0 20px var(--neon-blue-glow);
        }

        .header-logo span {
            color: var(--neon-blue);
        }

        .system-specs {
            display: flex;
            align-items: center;
            gap: 20px;
            font-family: var(--font-hud);
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .spec-item {
            border-left: 2px solid var(--neon-violet);
            padding-left: 10px;
        }

        .spec-value {
            color: var(--neon-blue);
            font-weight: bold;
        }

        /* Audio Control Switch */
        .audio-ctrl {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            padding: 5px 12px;
            border: 1px solid var(--border-color);
            background: rgba(0, 240, 255, 0.05);
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .audio-ctrl:hover {
            border-color: var(--neon-blue);
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
            color: #fff;
        }

        .audio-icon {
            width: 14px;
            height: 14px;
            fill: var(--neon-blue);
        }

        /* Main Workspace Layout */
        .workspace {
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 20px;
            padding: 20px;
            flex: 1;
            overflow: hidden;
            max-width: 1600px;
            width: 100%;
            margin: 0 auto;
        }

        /* Left Console Panel (Profile) */
        .side-console {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            overflow-y: auto;
            backdrop-filter: blur(12px);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
            position: relative;
        }

        .side-console::before {
            content: "PROFILE_MONITOR";
            position: absolute;
            top: 5px;
            right: 10px;
            font-family: var(--font-hud);
            font-size: 0.65rem;
            color: var(--neon-blue);
            opacity: 0.6;
        }

        /* Avatar Hologram Graphic */
        .avatar-container {
            width: 150px;
            height: 150px;
            margin: 0 auto;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .avatar-radar {
            position: absolute;
            width: 100%;
            height: 100%;
            border: 2px dashed var(--border-color);
            border-radius: 50%;
            animation: rotate-radar 20s linear infinite;
        }

        .avatar-radar-inner {
            position: absolute;
            width: 85%;
            height: 85%;
            border: 1px solid var(--neon-blue);
            border-radius: 50%;
            opacity: 0.3;
            animation: pulse-radar 4s ease-in-out infinite alternate;
        }

        @keyframes rotate-radar {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        @keyframes pulse-radar {
            0% { transform: scale(0.9); opacity: 0.2; }
            100% { transform: scale(1.05); opacity: 0.5; }
        }

        /* SVG Hologram Face Matrix */
        .avatar-hologram {
            width: 100px;
            height: 100px;
            color: var(--neon-blue);
            filter: drop-shadow(0 0 8px var(--neon-blue));
            z-index: 2;
        }

        .profile-info {
            text-align: center;
        }

        .profile-name {
            font-family: var(--font-hud);
            font-size: 1.5rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 5px;
            letter-spacing: 1px;
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
        }

        .profile-title {
            font-family: var(--font-hud);
            font-size: 0.85rem;
            color: var(--neon-blue);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }

        .profile-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--border-color) 20%, var(--border-color) 80%, transparent);
            margin: 10px 0;
        }

        .info-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
            font-size: 0.95rem;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .info-label {
            color: var(--text-muted);
            min-width: 80px;
            font-family: var(--font-hud);
            font-size: 0.75rem;
            text-transform: uppercase;
        }

        .info-value {
            color: #fff;
            font-weight: 600;
        }

        .tag-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }

        .badge {
            font-family: var(--font-hud);
            font-size: 0.7rem;
            padding: 4px 8px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            background: rgba(189, 0, 255, 0.05);
            color: var(--neon-violet);
            box-shadow: inset 0 0 5px rgba(189, 0, 255, 0.1);
        }

        .badge.cyan {
            background: rgba(0, 240, 255, 0.05);
            color: var(--neon-blue);
            border-color: rgba(0, 240, 255, 0.2);
            box-shadow: inset 0 0 5px rgba(0, 240, 255, 0.1);
        }

        /* Action Buttons */
        .btn-list {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .hud-btn {
            font-family: var(--font-hud);
            font-size: 0.85rem;
            font-weight: bold;
            text-transform: uppercase;
            text-decoration: none;
            text-align: center;
            color: var(--neon-blue);
            background: rgba(0, 240, 255, 0.05);
            border: 1px solid var(--border-color);
            padding: 12px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

        .hud-btn:hover {
            background: rgba(0, 240, 255, 0.15);
            border-color: var(--neon-blue);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
            text-shadow: 0 0 5px #fff;
            color: #fff;
            transform: translateY(-2px);
        }

        .hud-btn-secondary {
            color: var(--neon-violet);
            background: rgba(189, 0, 255, 0.05);
        }

        .hud-btn-secondary:hover {
            background: rgba(189, 0, 255, 0.15);
            border-color: var(--neon-violet);
            box-shadow: 0 0 15px rgba(189, 0, 255, 0.3);
            color: #fff;
        }

        /* Right Panel: Interactive Dashboard Grid */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: repeat(2, 1fr);
            gap: 20px;
            height: 100%;
        }

        /* Tactical Grid Module Card */
        .dash-card {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            cursor: pointer;
            backdrop-filter: blur(12px);
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        /* Cyber Design Accents (Corner brackets) */
        .dash-card::before, .dash-card::after {
            content: "";
            position: absolute;
            width: 10px;
            height: 10px;
            border-color: var(--neon-blue);
            border-style: solid;
            opacity: 0.5;
            transition: all 0.3s ease;
        }
        .dash-card::before {
            top: 5px; left: 5px;
            border-width: 1px 0 0 1px;
        }
        .dash-card::after {
            bottom: 5px; right: 5px;
            border-width: 0 1px 1px 0;
        }

        /* Card Hover Effects */
        .dash-card:hover {
            border-color: var(--neon-blue);
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.25), inset 0 0 15px rgba(0, 240, 255, 0.05);
            transform: translateY(-5px);
        }

        .dash-card:hover::before, .dash-card:hover::after {
            width: 20px;
            height: 20px;
            opacity: 1;
        }

        /* Card 2 Specific style variation (Purple accent) */
        .dash-card.alt-accent::before, .dash-card.alt-accent::after {
            border-color: var(--neon-violet);
        }
        .dash-card.alt-accent:hover {
            border-color: var(--neon-violet);
            box-shadow: 0 0 25px rgba(189, 0, 255, 0.25), inset 0 0 15px rgba(189, 0, 255, 0.05);
        }

        .card-header-hud {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .card-id {
            font-family: var(--font-hud);
            font-size: 0.75rem;
            color: var(--neon-blue);
            letter-spacing: 1px;
        }

        .dash-card.alt-accent .card-id {
            color: var(--neon-violet);
        }

        .card-sys-status {
            font-family: var(--font-hud);
            font-size: 0.65rem;
            padding: 2px 6px;
            border-radius: 2px;
            background: rgba(0, 240, 255, 0.1);
            color: var(--neon-blue);
        }

        .dash-card.alt-accent .card-sys-status {
            background: rgba(189, 0, 255, 0.1);
            color: var(--neon-violet);
        }

        .card-title-main {
            font-family: var(--font-hud);
            font-size: 1.4rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 10px;
            letter-spacing: 0.5px;
        }

        .card-subtitle {
            font-family: var(--font-hud);
            font-size: 0.8rem;
            color: var(--neon-blue);
            margin-bottom: 15px;
            text-transform: uppercase;
        }

        .dash-card.alt-accent .card-subtitle {
            color: var(--neon-violet);
        }

        .card-preview-text {
            color: var(--text-muted);
            line-height: 1.5;
            font-size: 0.95rem;
            margin-bottom: 20px;
        }

        .card-action-hint {
            font-family: var(--font-hud);
            font-size: 0.75rem;
            color: var(--neon-blue);
            align-self: flex-start;
            display: flex;
            align-items: center;
            gap: 5px;
            margin-top: auto;
        }

        .dash-card.alt-accent .card-action-hint {
            color: var(--neon-violet);
        }

        .card-action-hint svg {
            transition: transform 0.3s ease;
        }

        .dash-card:hover .card-action-hint svg {
            transform: translateX(5px);
        }

        /* --- DETAILS OVERLAY / FULLSCREEN MODAL --- */
        .overlay-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(2, 2, 8, 0.95);
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s cubic-bezier(0.075, 0.82, 0.165, 1);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
            backdrop-filter: blur(15px);
        }

        .overlay-screen.active {
            opacity: 1;
            visibility: visible;
        }

        .overlay-container {
            width: 100%;
            max-width: 1100px;
            max-height: 90%;
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            box-shadow: 0 0 50px rgba(0, 240, 255, 0.15);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            transform: scale(0.9);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.1);
        }

        .overlay-screen.active .overlay-container {
            transform: scale(1);
        }

        /* Border accents for modal */
        .overlay-container::before {
            content: "SYSTEM_EXPANDED_VIEW // CONSOLE";
            position: absolute;
            top: 5px;
            left: 15px;
            font-family: var(--font-hud);
            font-size: 0.65rem;
            color: var(--neon-blue);
            opacity: 0.6;
        }

        .overlay-header {
            padding: 20px 25px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 15px;
        }

        .overlay-header-title {
            font-family: var(--font-hud);
            font-size: 1.6rem;
            font-weight: 700;
            color: #fff;
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
        }

        .overlay-header-title span {
            color: var(--neon-blue);
        }

        .overlay-close-btn {
            background: none;
            border: 1px solid var(--border-color);
            color: var(--neon-blue);
            font-family: var(--font-hud);
            font-size: 0.8rem;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .overlay-close-btn:hover {
            background: rgba(0, 240, 255, 0.15);
            border-color: var(--neon-blue);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
            color: #fff;
        }

        .overlay-body {
            padding: 30px;
            overflow-y: auto;
            flex: 1;
        }

        /* Modal Grid Split Layout */
        .modal-split-layout {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 30px;
        }

        .modal-text-col {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .modal-visual-col {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .modal-section {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: 6px;
            position: relative;
        }

        .modal-section::before {
            content: "";
            position: absolute;
            top: 0; left: 0;
            width: 3px; height: 100%;
            background: var(--neon-blue);
        }

        .modal-section.violet-accent::before {
            background: var(--neon-violet);
        }

        .modal-section-title {
            font-family: var(--font-hud);
            font-size: 1.1rem;
            color: #fff;
            margin-bottom: 12px;
            text-transform: uppercase;
        }

        .modal-p-text {
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 15px;
            font-size: 1rem;
        }

        .modal-bullet-list {
            list-style: none;
            padding-left: 5px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .modal-bullet-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 1rem;
        }

        .modal-bullet-item svg {
            margin-top: 4px;
            flex-shrink: 0;
            color: var(--neon-blue);
        }

        /* Timeline Graphics for Case 1 */
        .timeline-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 10px;
        }

        .timeline-step {
            display: flex;
            gap: 15px;
            position: relative;
        }

        .timeline-step:not(:last-child)::after {
            content: "";
            position: absolute;
            left: 20px;
            top: 30px;
            width: 2px;
            height: calc(100% - 15px);
            background: rgba(0, 240, 255, 0.2);
        }

        .timeline-time {
            font-family: var(--font-hud);
            font-size: 0.85rem;
            color: var(--neon-blue);
            min-width: 50px;
            padding: 5px;
            border: 1px solid rgba(0, 240, 255, 0.3);
            border-radius: 4px;
            text-align: center;
            height: fit-content;
            background: rgba(0, 240, 255, 0.05);
        }

        .timeline-details {
            flex: 1;
            padding-bottom: 15px;
        }

        .timeline-title {
            font-weight: 700;
            color: #fff;
            font-size: 1.05rem;
            margin-bottom: 4px;
        }

        .timeline-desc {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.4;
        }

        /* Diagram / Matrix Graphics for Case 2 */
        .visual-matrix {
            border: 1px dashed var(--border-color);
            background: rgba(0, 0, 0, 0.4);
            border-radius: 6px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }

        .security-nodes {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            width: 100%;
        }

        .sec-node {
            border: 1px solid rgba(189, 0, 255, 0.3);
            background: rgba(189, 0, 255, 0.05);
            border-radius: 4px;
            padding: 10px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .sec-node.active {
            border-color: var(--neon-blue);
            background: rgba(0, 240, 255, 0.05);
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
        }

        .sec-node-title {
            font-family: var(--font-hud);
            font-size: 0.75rem;
            color: #fff;
            margin-bottom: 5px;
        }

        .sec-node-status {
            font-family: var(--font-hud);
            font-size: 0.65rem;
            color: var(--neon-violet);
        }

        .sec-node.active .sec-node-status {
            color: var(--neon-blue);
        }

        /* Cyberpunk Terminal Simulator for Case 3 & general HUD */
        .terminal-box {
            background-color: var(--terminal-bg);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
            display: flex;
            flex-direction: column;
            height: 300px;
        }

        .terminal-header {
            background-color: rgba(10, 10, 30, 0.9);
            padding: 8px 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

        .terminal-dots {
            display: flex;
            gap: 6px;
        }

        .term-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .term-dot.red { background-color: #ff5f56; }
        .term-dot.yellow { background-color: #ffbd2e; }
        .term-dot.green { background-color: #27c93f; }

        .terminal-title-text {
            font-family: var(--font-hud);
            font-size: 0.7rem;
            color: var(--text-muted);
            letter-spacing: 1px;
        }

        .terminal-body {
            padding: 15px;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            overflow-y: auto;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 8px;
            color: #4ade80; /* retro green */
        }

        .term-input {
            color: var(--neon-blue);
        }

        .term-output {
            color: var(--text-main);
            opacity: 0.85;
            white-space: pre-wrap;
            line-height: 1.4;
        }

        .term-success {
            color: #4ade80;
        }

        .term-warning {
            color: #fbbf24;
        }

        .term-error {
            color: #f87171;
        }

        /* Tech Skill Progress bars for Case 3 */
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .skill-progress-container {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .skill-progress-header {
            display: flex;
            justify-content: space-between;
            font-family: var(--font-hud);
            font-size: 0.8rem;
        }

        .skill-name {
            color: #fff;
        }

        .skill-percent {
            color: var(--neon-blue);
        }

        .skill-bar-outer {
            height: 8px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 4px;
            overflow: hidden;
            position: relative;
        }

        .skill-bar-inner {
            height: 100%;
            background: linear-gradient(90deg, var(--neon-violet), var(--neon-blue));
            border-radius: 4px;
            width: 0; /* Animated dynamically on open */
            transition: width 1.5s cubic-bezier(0.1, 0.8, 0.3, 1);
            box-shadow: 0 0 10px var(--neon-blue-glow);
        }

        /* Interactive Contact Form inside Case 4 */
        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-label {
            font-family: var(--font-hud);
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .form-input {
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid var(--border-color);
            padding: 12px;
            border-radius: 4px;
            color: #fff;
            font-family: var(--font-body);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--neon-blue);
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
            background: rgba(0, 240, 255, 0.02);
        }

        textarea.form-input {
            resize: none;
            height: 100px;
        }

        /* Success notification alert */
        .hud-alert {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: var(--panel-bg);
            border: 1px solid var(--neon-blue);
            border-radius: 4px;
            padding: 15px 25px;
            z-index: 2000;
            display: flex;
            align-items: center;
            gap: 12px;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 0 20px var(--neon-blue-glow);
            backdrop-filter: blur(10px);
        }

        .hud-alert.active {
            transform: translateY(0);
            opacity: 1;
        }

        .alert-title {
            font-family: var(--font-hud);
            font-size: 0.9rem;
            color: #fff;
            margin-bottom: 2px;
        }

        .alert-msg {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* Footer System Status Ticker */
        footer {
            width: 100%;
            padding: 10px 30px;
            background: rgba(2, 2, 8, 0.9);
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: var(--font-hud);
            font-size: 0.7rem;
            color: var(--text-muted);
            z-index: 100;
        }

        .footer-ticker {
            overflow: hidden;
            white-space: nowrap;
            width: 50%;
            position: relative;
        }

        .ticker-inner {
            display: inline-block;
            padding-left: 100%;
            animation: ticker 30s linear infinite;
        }

        @keyframes ticker {
            0% { transform: translate3d(0, 0, 0); }
            100% { transform: translate3d(-100%, 0, 0); }
        }

        /* --- RESPONSIVE DESIGN --- */
        @media (max-width: 1024px) {
            .workspace {
                grid-template-columns: 1fr;
                overflow-y: auto;
                height: auto;
            }
            body {
                overflow-y: auto;
                height: auto;
            }
            .side-console {
                height: auto;
                overflow-y: visible;
            }
            .dashboard-grid {
                grid-template-columns: 1fr;
                height: auto;
                gap: 20px;
            }
            .overlay-screen {
                padding: 10px;
            }
            .overlay-body {
                padding: 15px;
            }
            .modal-split-layout {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            .skills-grid {
                grid-template-columns: 1fr;
            }
            header {
                padding: 15px;
            }
            .system-specs {
                display: none;
            }
        }

        @media (max-width: 768px) {
            body::after {
                background-size: 100% 2px;
            }
            .cyber-grid {
                background-size: 20px 20px;
            }
            .overlay-container {
                max-height: 95%;
            }
            .overlay-header {
