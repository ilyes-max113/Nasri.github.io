            }
            .timeline-step {
                flex-direction: column;
                gap: 5px;
            }
            .timeline-step:not(:last-child)::after {
                display: none;
            }
            .timeline-time {
                min-width: unset;
                align-self: flex-start;
            }
        }
    </style>
</head>
